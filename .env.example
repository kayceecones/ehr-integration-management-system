# Postgres. On Render this is set automatically when the service is linked to
# the database; locally, copy it from the database's Connect panel.
DATABASE_URL=postgresql://user:pass@host:5432/ehr_access_registry

# Free read-only key for the ONC Certified Health IT Product List.
# Request at https://chpl.healthit.gov (Resources -> CHPL API) and confirm by email.
CHPL_API_KEY=

# Notion integration token and the EHR Access Requests data source id.
# The mirror is skipped entirely when these are unset, so the system runs
# without Notion configured.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=269affab-5e94-4114-9cb9-90a5c68e928f

PORT=3000
